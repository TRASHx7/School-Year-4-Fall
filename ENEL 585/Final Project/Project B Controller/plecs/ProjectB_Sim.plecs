        Variable      "StartFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "OutputFcn"
        Value         "double t = CurrentTime;\n"
"Output(0) = (t >= T_EN) ? 1.0 : 0.0;\n"
"Output(1) = (t >= T_UP && t < T_DN) ? V_2 : ((t >= T_LON) ? V_2 : V_1);\n"
"Output(2) = (t >= T_LON && t < T_LOF) ? 1.0 : 0.0;"
        Show          off
      }
      Parameter {
