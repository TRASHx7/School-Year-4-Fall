      Parameter {
        Variable      "Declarations"
        Value         "/*\n * ENEL 585 Fall 2026, Project B: single-phase standalone inverter con"
"troller.\n * Group 8 (Station 5 per the Oct 29 list).\n *\n * This file is"
" the single source of the controller. It is pasted (by gen_plecs.py) into "
"the\n * \"Declarations\" section of the C-Script block in both PLECS model"
"s, and it is compiled\n * unchanged by design/simulate.py for the switched"
" simulation. Do not edit the copies inside\n * the .plecs files; edit this"
" file and regenerate.\n *\n * Control law (one call per PWM carrier period"
", sampled at the carrier valley):\n *   theta_k  = 2 pi k / N, N = carrier"
" periods per 60 Hz period (table based, synchronous)\n *   vref     = A si"
"n(theta_k)                       A = sqrt(2) Vref_rms (soft start, then st"
"eps\n *                                                   applied at the p"
"ositive zero crossing)\n *   e        = vref - vo\n *   xd, xq  += 2 Ki Ts"
" e sin(theta), 2 Ki Ts e cos(theta)      (resonant term, see below)\n *   "
"u_r      = xd sin(theta) + xq cos(theta)\n *   v*       = FF vref + Kp e +"
" u_r\n *   m        = v* / vdc,  |m| <= M_MAX\n *   dA = (1 + m)/2, dB = ("
"1 - m)/2                  (unipolar SPWM: both legs, same carrier)\n *\n *"
" The pair (xd, xq) is the ideal resonant term of Lecture 11: demodulate, i"
"ntegrate, remodulate\n * gives u_r(t) = 2 Ki * integral e(t') cos(w1 (t - "
"t')) dt', whose Laplace transform is\n * 2 Ki s / (s^2 + w1^2). Because si"
"n and cos come from the same table as the reference, the\n * resonance sit"
"s exactly on the reference frequency, with no drift in single precision.\n"
" * Anti-windup: the correction amplitude sqrt(xd^2 + xq^2) is clamped to X"
"_MAX.\n *\n * Protection (latched, PWM off, cleared only by setting enable"
"switch to 0). The vo, iL and io\n * levels can be lowered live for HIL tes"
"ts (Trip_vo, Trip_iL, Trip_io), never raised:\n *   bit 0  |vo|  > TRIP_VO"
"        bit 3  vdc > TRIP_VDC_HI\n *   bit 1  |iL|  > TRIP_IL        bit 4"
"  vdc < TRIP_VDC_LO while running\n *   bit 2  |io|  > TRIP_IO        bit "
"5  vo polarity opposite to vref during soft start\n */\n\n#include <math.h"
">\n\n#define PB_MAX_N 512\n\ntypedef struct {\n    /* fixed parameters (C-"
"Script \"Parameters\" or the test harness) */\n    int   N;            /* "
"table length = carrier periods per fundamental period */\n    float Ts;   "
"        /* control period, s */\n    float v_scale, v_offset;   /* voltage"
" channel: x = scale * Vpin + offset */\n    float i_scale, i_offset;   /* "
"current channel */\n    float trip_vo, trip_il, trip_io, trip_vdc_hi, trip"
"_vdc_lo;\n    float vdc_start_min;\n    float m_max;\n    float x_max;\n  "
"  float ramp_rate;    /* V/s of peak amplitude during soft start */\n} pb_"
"param_t;\n\ntypedef struct {\n    /* measured pin voltages (V), in this or"
"der on the C-Script input */\n    float vpin_vdc, vpin_il, vpin_vo, vpin_i"
"o;\n    /* operator inputs (tunable constants in the model) */\n    float "
"enable;       /* enableswitch: 0 off, 1 on */\n    float vref_rms;     /* "
"output voltage reference, V rms */\n    float kp;           /* proportiona"
"l gain */\n    float ki;           /* resonant gain, 1/s */\n    float ff;"
"           /* reference feedforward gain (1 on, 0 off) */\n    /* test thr"
"esholds: can only LOWER the trips below the fixed design values (0 = use d"
"esign) */\n    float trip_vo_set, trip_il_set, trip_io_set;\n} pb_in_t;\n"
"\ntypedef struct {\n    float dA, dB;       /* duty of leg A (ePWM1) and l"
"eg B (ePWM2), 0..1 */\n    float pwm_en;       /* to the Powerstage Protec"
"tion block */\n    float fault;        /* latched fault bits */\n    float"
" amp;          /* present reference amplitude, V peak */\n    float m;    "
"        /* modulation index after the limit */\n    float x_amp;        /*"
" resonant correction amplitude, V */\n    float vref;         /* instantan"
"eous reference, V */\n    float vdc, il, vo, io;   /* measurements in phys"
"ical units */\n} pb_out_t;\n\n#define PB_NUM_OUTPUTS 12\n\ntypedef struct "
"{\n    int   k;            /* table index 0..N-1 */\n    int   run;       "
"   /* 1 while switching */\n    int   soft;         /* 1 during soft start"
" */\n    int   fault;        /* latched fault bits */\n    float amp;     "
"     /* reference amplitude now */\n    float xd, xq;       /* resonant st"
"ates */\n    float pol_acc;      /* polarity check accumulator over one cy"
"cle */\n} pb_state_t;\n\nstatic float pb_sin[PB_MAX_N];\nstatic float pb_c"
"os[PB_MAX_N];\n\nstatic void pb_init(pb_state_t *s, const pb_param_t *p)\n"
"{\n    int n;\n    int N = p->N;\n    if (N > PB_MAX_N) N = PB_MAX_N;\n   "
" for (n = 0; n < N; n++) {\n        pb_sin[n] = (float)sin(6.2831853071795"
"86 * n / N);\n        pb_cos[n] = (float)cos(6.283185307179586 * n / N);\n"
"    }\n    s->k = 0;\n    s->run = 0;\n    s->soft = 0;\n    s->fault = 0;"
"\n    s->amp = 0.0f;\n    s->xd = 0.0f;\n    s->xq = 0.0f;\n    s->pol_acc"
" = 0.0f;\n}\n\nstatic float pb_absf(float x) { return x < 0.0f ? -x : x; }"
"\n\n/* One control step. Reads *s, writes the outputs to *o and the next s"
"tate to *ns.\n * Pure function of (input, state), so it can be called from"
" both the output and the update\n * function of the C-Script without doubl"
"e-updating the state. */\nstatic void pb_step(const pb_in_t *in, const pb_"
"state_t *s, const pb_param_t *p,\n                    pb_out_t *o, pb_stat"
"e_t *ns)\n{\n    int N = p->N > PB_MAX_N ? PB_MAX_N : p->N;\n    int k = s"
"->k;\n    float sn, cs, vdc, il, vo, io, target, vref, e, ur, vstar, m, de"
"n, xa, sc, xlim;\n    float t_vo, t_il, t_io;\n    int trip = 0;\n\n    *n"
"s = *s;\n\n    /* measurements in physical units */\n    vdc = p->v_scale "
"* in->vpin_vdc + p->v_offset;\n    il  = p->i_scale * in->vpin_il  + p->i_"
"offset;\n    vo  = p->v_scale * in->vpin_vo  + p->v_offset;\n    io  = p->"
"i_scale * in->vpin_io  + p->i_offset;\n\n    sn = pb_sin[k];\n    cs = pb_"
"cos[k];\n\n    /* ---------------- protection: always armed --------------"
"-- */\n    /* tunable test thresholds may lower a trip, never raise it */"
"\n    t_vo = (in->trip_vo_set > 0.0f && in->trip_vo_set < p->trip_vo) ? in"
"->trip_vo_set : p->trip_vo;\n    t_il = (in->trip_il_set > 0.0f && in->tri"
"p_il_set < p->trip_il) ? in->trip_il_set : p->trip_il;\n    t_io = (in->tr"
"ip_io_set > 0.0f && in->trip_io_set < p->trip_io) ? in->trip_io_set : p->t"
"rip_io;\n    if (pb_absf(vo) > t_vo)             trip |= 1;\n    if (pb_ab"
"sf(il) > t_il)             trip |= 2;\n    if (pb_absf(io) > t_io)        "
"     trip |= 4;\n    if (vdc > p->trip_vdc_hi)           trip |= 8;\n    i"
"f (s->run && vdc < p->trip_vdc_lo) trip |= 16;\n    ns->fault = s->fault |"
" trip;\n\n    /* fault is acknowledged only by switching enable off */\n  "
"  if (in->enable < 0.5f) {\n        ns->fault = 0;\n    }\n\n    /* ------"
"---------- run / stop ---------------- */\n    if (in->enable < 0.5f || ns"
"->fault) {\n        ns->run = 0;\n        ns->soft = 0;\n        ns->amp ="
" 0.0f;\n        ns->xd = 0.0f;\n        ns->xq = 0.0f;\n        ns->pol_ac"
"c = 0.0f;\n    } else if (!s->run) {\n        /* start at a positive-going"
" zero crossing of the reference, with enough DC link */\n        if (k == "
"0 && vdc > p->vdc_start_min) {\n            ns->run = 1;\n            ns->"
"soft = 1;\n            ns->amp = 0.0f;\n            ns->pol_acc = 0.0f;\n "
"       }\n    }\n\n    /* ---------------- reference amplitude -----------"
"----- */\n    target = 1.41421356f * in->vref_rms;\n    if (target < 0.0f)"
" target = 0.0f;\n    if (target > p->trip_vo * 0.98f) target = p->trip_vo "
"* 0.98f;\n\n    if (ns->run) {\n        if (ns->soft) {\n            /* fi"
"rst step after the start: amp stays 0; then ramp at ramp_rate */\n        "
"    ns->amp = s->run ? s->amp + p->ramp_rate * p->Ts : 0.0f;\n            "
"if (ns->amp >= target) {\n                ns->amp = target;\n             "
"   ns->soft = 0;\n            }\n            /* polarity check: vo must be"
" in phase with vref once the amplitude is a few volts */\n            ns->"
"pol_acc = s->pol_acc + vo * sn;\n            if (k == N - 1) {\n          "
"      if (s->amp > 2.0f && ns->pol_acc < 0.0f) ns->fault |= 32;\n         "
"       ns->pol_acc = 0.0f;\n            }\n            if (ns->fault) {\n "
"               ns->run = 0;\n                ns->soft = 0;\n              "
"  ns->amp = 0.0f;\n            }\n        } else if (k == 0) {\n          "
"  ns->amp = target;   /* reference steps take effect at the zero crossing "
"*/\n        } else {\n            ns->amp = s->amp;\n        }\n    }\n\n "
"   vref = ns->amp * sn;\n    e = vref - vo;\n\n    /* ---------------- res"
"onant term (ideal R, Lecture 11) with anti-windup ---------------- */\n   "
" if (ns->run && !ns->fault) {\n        float g = 2.0f * in->ki * p->Ts * e"
";\n        ns->xd = s->xd + g * sn;\n        ns->xq = s->xq + g * cs;\n   "
"     /* with feedforward off, the resonant term must supply the whole outp"
"ut */\n        xlim = p->x_max + (1.0f - in->ff) * 1.2f * target;\n       "
" xa = sqrtf(ns->xd * ns->xd + ns->xq * ns->xq);\n        if (xa > xlim) {"
"\n            sc = xlim / xa;\n            ns->xd *= sc;\n            ns->"
"xq *= sc;\n            xa = xlim;\n        }\n    } else {\n        ns->xd"
" = 0.0f;\n        ns->xq = 0.0f;\n        xa = 0.0f;\n    }\n    ur = ns->"
"xd * sn + ns->xq * cs;\n\n    /* ---------------- modulation -------------"
"--- */\n    vstar = in->ff * vref + in->kp * e + ur;\n    den = vdc > 10.0"
"f ? vdc : 10.0f;\n    m = vstar / den;\n    if (m > p->m_max) m = p->m_max"
";\n    if (m < -p->m_max) m = -p->m_max;\n\n    if (ns->run && !ns->fault)"
" {\n        o->dA = 0.5f + 0.5f * m;\n        o->dB = 0.5f - 0.5f * m;\n  "
"      o->pwm_en = 1.0f;\n    } else {\n        o->dA = 0.5f;\n        o->d"
"B = 0.5f;\n        o->pwm_en = 0.0f;\n        m = 0.0f;\n    }\n\n    o->f"
"ault = (float)ns->fault;\n    o->amp = ns->amp;\n    o->m = m;\n    o->x_a"
"mp = xa;\n    o->vref = vref;\n    o->vdc = vdc;\n    o->il = il;\n    o->"
"vo = vo;\n    o->io = io;\n\n    ns->k = (k + 1 >= N) ? 0 : k + 1;\n}\n\n/"
"* ---- C-Script glue (generated by gen_plecs.py) ---- */\nstatic pb_param_"
"t pbP;\nstatic pb_state_t pbS, pbNext;\nstatic pb_in_t pbIn;\nstatic pb_ou"
"t_t pbOut;\n#define PRM(i) ((float)ParamRealData(i, 0))\nstatic float simD"
"A = 0.5f, simDB = 0.5f, simEN = 0.0f;\n"
        Show          off
      }
      Parameter {
        Variable      "StartFcn"
        Value         "pbP.N = (int)(ParamRealData(0, 0) + 0.5);\npbP.Ts = PRM(1);\npbP.v_scale ="
" PRM(2);\npbP.v_offset = PRM(3);\npbP.i_scale = PRM(4);\npbP.i_offset = PR"
"M(5);\npbP.trip_vo = PRM(6);\npbP.trip_il = PRM(7);\npbP.trip_io = PRM(8);"
"\npbP.trip_vdc_hi = PRM(9);\npbP.trip_vdc_lo = PRM(10);\npbP.vdc_start_min"
" = PRM(11);\npbP.m_max = PRM(12);\npbP.x_max = PRM(13);\npbP.ramp_rate = P"
"RM(14);\npb_init(&pbS, &pbP);\npbNext = pbS;"
        Show          off
      }
      Parameter {
        Variable      "OutputFcn"
        Value         "pbIn.vpin_vdc = (float)Input(0);\npbIn.vpin_il = (float)Input(1);\npbIn.vp"
"in_vo = (float)Input(2);\npbIn.vpin_io = (float)Input(3);\npbIn.enable = ("
"float)Input(4);\npbIn.vref_rms = (float)Input(5);\npbIn.kp = (float)Input("
"6);\npbIn.ki = (float)Input(7);\npbIn.ff = (float)Input(8);\npbIn.trip_vo_"
"set = (float)Input(9);\npbIn.trip_il_set = (float)Input(10);\npbIn.trip_io"
"_set = (float)Input(11);\npb_step(&pbIn, &pbS, &pbP, &pbOut, &pbNext);\nOu"
"tput(0) = simDA;\nOutput(1) = simDB;\nOutput(2) = simEN;\nOutput(3) = pbOu"
"t.fault;\nOutput(4) = pbOut.amp;\nOutput(5) = pbOut.m;\nOutput(6) = pbOut."
"x_amp;\nOutput(7) = pbOut.vref;\nOutput(8) = pbOut.vdc;\nOutput(9) = pbOut"
".il;\nOutput(10) = pbOut.vo;\nOutput(11) = pbOut.io;"
        Show          off
      }
      Parameter {
        Variable      "UpdateFcn"
        Value         "pbS = pbNext;\nsimDA = pbOut.dA;\nsimDB = pbOut.dB;\nsimEN = pbOut.pwm_en;"
        Show          off
      }
      Parameter {
        Variable      "DerivativeFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "TerminateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "StoreCustomStateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "RestoreCustomStateFcn"
        Value         ""
        Show          off
      }
    }
    Component {
      Type          SignalDemux
      Name          "Demux"
      Show          off
