  InitializationCommands "%% ENEL 585 Project B, Group 8: switched simulation (generated by gen_plec"
"s.py)\n% PWM timing: carrier synchronous with 60 Hz, as in Lab 2\nf1 = 60;"
"\nNper = 166;          % carrier periods per 60 Hz period (even, unipolar)"
"\nfclk = 50e6;          % ePWM time-base clock of the TI28P55x target\nfsw"
" = fclk/(2*round(fclk/(2*Nper*f1)));   % 9960.16 Hz\nfcar = fsw;\nTctrl = "
"1/fsw;        % control period (one sample per carrier period)\ndeadtime ="
" 2e-06;    % s (Lab 2 used 5e-6; the SKHI 22A driver adds its own interloc"
"k)\n% Controller defaults (tunable blocks Kp, Ki, FF, Vref_rms)\nKp0 = 0.0"
"1;\nKi0 = 60.0;\n\n% Station\nVdc = 55.0;          % ITECH set point\nR_it"
"ech = 0.05;\nCdc = 0.0011;\nLf = 4.7e-05;       % each branch; scale for t"
"he +/-20 % tolerance cases\nR_Lf = 0.0118;\nCf = 6.2e-05;\nR_bleed = 100e3"
";\nRon = 0.03;           % switch on-resistance (stand-in for the IGBT/dio"
"de drop)\nR_load_A = 25;        % always connected\nR_load_B = 25;        "
"% switched in by the sequencer: 25 ohm -> 12.5 ohm\n\n% Sensing filter H(s"
"): bench = two poles + zero; HIL model = one pole + zero\nsensing_bench = "
"1;\nwz = 2*pi*1446.9; wp1 = 2*pi*723.4; wp2 = 2*pi*871.9;\nif sensing_benc"
"h\n  Hnum = [1/wz 1];\n  Hden = [1/(wp1*wp2) 1/wp1+1/wp2 1];\nelse\n  Hnum"
" = [1/wz 1];\n  Hden = [1/wp2 1];\nend\n\n% The simulation feeds physical "
"values to the controller, so its ADC scaling is unity\nVscale = 1; Voffset"
" = 0; Iscale = 1; Ioffset = 0;\n\n% Test sequence (s): enable, reference s"
"tep, load step\nt_enable = 0.001;\nV1 = 25.0;   V2 = 30.0;   % V rms\nt_re"
"f_up = 0.60;   t_ref_down = 0.80;\nt_load_on = 1.00;  t_load_off = 1.20;  "
" % load step at V2: 25 ohm -> 12.5 ohm -> 25 ohm\n\n% Protection (fixed in"
" the firmware; Trip_vo/Trip_iL/Trip_io can only lower them)\nTRIP_VO = 50."
"0;        % V peak, output overvoltage\nTRIP_IL = 7.0;         % A, induct"
"or overcurrent (sampled average)\nTRIP_IO = 6.0;         % A, load overcur"
"rent\nTRIP_VDC_HI = 58.0;    % V, DC-link overvoltage\nTRIP_VDC_LO = 35.0;"
"    % V, DC-link undervoltage while running\nVDC_START_MIN = 40.0;  % V, P"
"WM does not start below this\nM_MAX = 0.96;          % modulation limit\nX"
"_MAX = 15.0;          % V, anti-windup limit on the resonant correction\nR"
"AMP_RATE = 100.0;     % V/s of peak amplitude during soft start\n"
