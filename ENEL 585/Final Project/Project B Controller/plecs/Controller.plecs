  InitializationCommands "%% ENEL 585 Project B, Group 8: firmware model (gene"
"rated by gen_plecs.py)\n% PWM timing: carrier synchronous with 60 Hz, as in L"
"ab 2\nf1 = 60;\nNper = 166;          % carrier periods per 60 Hz period (even"
", unipolar)\nfclk = 50e6;          % ePWM time-base clock of the TI28P55x tar"
"get\nfsw = fclk/(2*round(fclk/(2*Nper*f1)));   % 9960.16 Hz\nfcar = fsw;\nTct"
"rl = 1/fsw;        % control period (one sample per carrier period)\ndeadtime"
" = 2e-06;    % s (Lab 2 used 5e-6; the SKHI 22A driver adds its own interlock"
")\n% Controller defaults (tunable blocks Kp, Ki, FF, Vref_rms)\nKp0 = 0.01;\n"
"Ki0 = 60.0;\n\n% ADC scaling, Inverter Box Setup Guide v3: V_pin = 1.62 + K *"
" V_BNC\nV_adc_offset = 1.62;\nVprobe_atten = 10.0;      % N2791A setting (10:"
"1)\nIprobe_VperA = 0.1;     % 1146B setting (100 mV/A)\nVscale = Vprobe_atten"
"/0.213;          % V per V at the pin\nVoffset = -V_adc_offset*Vscale;\nIscal"
"e = 1/(Iprobe_VperA*0.154);      % A per V at the pin\nIoffset = -V_adc_offse"
"t*Iscale;\n\n% Pins (HIL model and Setup Guide v3, Table 2)\nADC_A_CH = [6 10"
"];    % ADCINA6 = VProbe2 = v_dc,  ADCINA10 = CProbe1 = i_L1\nADC_B_CH = [2 0"
"];     % ADCINB2 = VProbe1 = v_o,   ADCINB0  = CProbe2 = i_o\nPWR_DSP_GPIO = "
"21;    % power-stage enable GPIO, as in the Tutorial 5 model\n\n% Protection "
"(fixed in the firmware; Trip_vo/Trip_iL/Trip_io can only lower them)\nTRIP_VO"
" = 50.0;        % V peak, output overvoltage\nTRIP_IL = 7.0;         % A, ind"
"uctor overcurrent (sampled average)\nTRIP_IO = 6.0;         % A, load overcur"
"rent\nTRIP_VDC_HI = 58.0;    % V, DC-link overvoltage\nTRIP_VDC_LO = 35.0;   "
" % V, DC-link undervoltage while running\nVDC_START_MIN = 40.0;  % V, PWM doe"
"s not start below this\nM_MAX = 0.96;          % modulation limit\nX_MAX = 15"
".0;          % V, anti-windup limit on the resonant correction\nRAMP_RATE = 1"
"00.0;     % V/s of peak amplitude during soft start\n"
