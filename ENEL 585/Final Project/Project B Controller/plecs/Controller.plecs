    Component {
      Type          Reference
      SrcComponent  "TIC2000_Lib/Powerstage Protection"
      Name          "Protection"
      Show          on
      Position      [680, 440]
      Direction     up
      Flipped       off
      LabelPosition south
      Frame         [-45, -25; 45, 25]
      Parameter {
        Variable      "EnableSignal"
        Value         "1"
        Show          off
