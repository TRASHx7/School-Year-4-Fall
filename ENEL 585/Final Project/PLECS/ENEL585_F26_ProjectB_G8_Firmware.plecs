    Component {
      Type          Reference
      SrcComponent  "TIC2000_Lib/Powerstage Protection"
      Name          "Powerstage Protection"
      Show          on
      Position      [560, 430]
      Direction     up
      Flipped       off
      LabelPosition south
      Frame         [-45, -25; 45, 25]
      Parameter {
        Variable      "EnableSignal"
        Value         "1"
        Show          off
      }
      Parameter {
        Variable      "EnableSignalPolarity"
        Value         "1"
        Show          off
      }
      Parameter {
        Variable      "EnableSignalGpio"
        Value         "PWR_GPIO"
        Show          off
      }
      Parameter {
        Variable      "PwmSafeState"
        Value         "1"
        Show          off
      }
      Parameter {
        Variable      "TripZone1Mode"
        Value         "1"
        Show          off
      }
      Parameter {
        Variable      "TripZone2Mode"
        Value         "1"
        Show          off
      }
      Parameter {
        Variable      "TripZone3Mode"
        Value         "1"
        Show          off
      }
      Parameter {
