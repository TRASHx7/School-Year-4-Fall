  AssertionAction "1"
  FixedPointDatatypeOverride "1"
  InitializationCommands "%% ENEL 585 Fall 2026, Project B: single-phase standalone inverter\n%% Group"
" 8, Station 6, Lab B01\n\n%% Timing: N_per samples per 60 Hz period. The car"
"rier is the nearest value the\n%% ePWM up-down counter hits exactly, so the "
"reference stays synchronous.\nf1    = 60;\nN_per = 166;                     "
"          % even; carrier periods per 60 Hz period\nfclk  = 150e6;          "
"                   % SYSCLK in the TI28P55x target settings [Hz]\nfsw   = fc"
"lk/(2*round(fclk/(2*N_per*f1))); % 9960.16 Hz, below the 10 kHz ceiling\nTs "
"   = 1/fsw;                             % control and ADC sample period [s]\n"
"dead_time = 2e-6;                          % per-leg dead time [s] (Lab 2 us"
"ed 5e-6)\n\n%% Sensing: V_pin = O + signal/K at the ADC pin (Inverter Box Se"
"tup Guide:\n%% 1.667 V centre, 0.213 V/V after the probe for voltage, 0.154 "
"V/V for current)\nK_vo = 10/0.213;  O_vo = 1.667;   % VProbe 1, 10:1: output"
" voltage, tap A - tap B\nK_il = 1/0.0154;  O_il = 1.667;   % CProbe 2, 100 m"
"V/A: leg-A inductor current\nK_io = 1/0.0154;  O_io = 1.667;   % CProbe 1, 1"
"00 mV/A: load current\nK_dc = 10/0.213;  O_dc = 1.667;   % VProbe 2, 10:1: d"
"c input voltage\nsrc  = [1 2 3 4];                 % pin carrying [vo iL io "
"vdc]: 1=B2 2=B0 3=B1 4=A6, 0=none\nH60  = 0.9949;                    % inter"
"face-board filter gain at 60 Hz (amplitude calibration)\nVdc_nom = 50;      "
"               % used if src(4) = 0\n\n%% Target: 1 = bench (interface board"
"), 2 = remote Typhoon HIL\ntarget = 1;\nif target == 2\n  % Replace with the"
" provided Project B HIL model's I/O before flashing:\n  % in its .tse, analo"
"g_outputs lists 'AOn;signal;scale;offset;...' per channel.\n  % The orientat"
"ion model used AO1 -> ADCINA6 and AO2 -> ADCINB2, scale 10.\n  K_vo = 10/0.2"
"13;  O_vo = 1.667;\n  K_il = 1/0.0154;  O_il = 1.667;\n  src  = [1 2 0 0];  "
"             % no io or vdc channel: feedforward uses Vdc_nom\nend\n\n%% Pin"
"s (Inverter Box Setup Guide, Table 1 and 2)\nADCB_CH   = [2 0 1];   % ADCINB"
"2 = VProbe 1, ADCINB0 = CProbe 2, ADCINB1 = CProbe 1\nADCA_CH   = [6];      "
" % ADCINA6 = VProbe 2\nPWM_LEG_A = 1;         % EPWM1A/B = Top 1 / Bot 1 (le"
"g A, Q1/Q2)\nPWM_LEG_B = 2;         % EPWM2A/B = Top 2 / Bot 2 (leg B, Q3/Q4"
")\nPWR_GPIO  = 21;        % powerstage enable output, as in the orientation "
"model\n\n%% Protection (latched; clear by setting enableswitch to 0). Pin vo"
"ltages:\nVo_trip  = 50;    % |vo| [V]   -> 0.602 V / 2.732 V\nIL_trip  = 9; "
"    % |iL| [A]   -> 1.528 V / 1.806 V\nIo_trip  = 6;     % |io| [A]   -> 1.5"
"75 V / 1.759 V\nVdc_trip = 55;    % vdc [V]    -> 2.839 V\nVdc_min  = 20;   "
" % switching starts only once the filtered vdc exceeds this [V]\n\n%% Amplit"
"ude control (see README for the loop design)\nVref_max = 32;    % largest ac"
"cepted Vref_rms [V]\nslew     = 5;     % amplitude slew [V pk per half cycle"
"] = 600 V/s, also the soft start\nm_max    = 0.98;  % modulation limit; anti"
"-windup holds the trim here\nx_max    = 10;    % integral trim limit [V pk]\n"
"I_lim    = 6;     % current limit on the half-cycle peak of the sensed iL [A"
"]\nK_fold   = 2;     % foldback gain [V pk per A per half cycle]\nfold_dec ="
" 0.5;   % foldback recovery [V pk per half cycle]\ntau_dc   = 0.02;  % dc-li"
"nk voltage filter for the feedforward [s]\n\nctl_par = [N_per Ts K_vo O_vo K"
"_il O_il K_io O_io K_dc O_dc src Vdc_nom H60 Vo_trip IL_trip Io_trip Vdc_tri"
"p Vdc_min Vref_max slew m_max x_max I_lim K_fold fold_dec tau_dc];\n"
  InitialState  "1"
