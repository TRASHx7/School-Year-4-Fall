  FixedPointDatatypeOverride "1"
  InitializationCommands "%% ENEL 585 Fall 2026, Project B: single-phase standalone inverter\n%% Group"
" 8, Station 6, Lab B01\n\n%% Timing: N_per samples per 60 Hz period. The car"
"rier is the nearest value the\n%% ePWM up-down counter hits exactly, so the "
"reference stays synchronous.\nf1    = 60;\nN_per = 166;                     "
"          % even; carrier periods per 60 Hz period\nfclk  = 150e6;          "
"                   % SYSCLK in the TI28P55x target settings [Hz]\nfsw   = fc"
"lk/(2*round(fclk/(2*N_per*f1))); % 9960.16 Hz, below the 10 kHz ceiling\nTs "
"   = 1/fsw;                             % control and ADC sample period [s]\n"
"dead_time = 2e-6;                          % per-leg dead time [s] (Lab 2 us"
"ed 5e-6)\n\n%% Sensing: V_pin = O + signal/K at the ADC pin (Inverter Box Se"
"tup Guide:\n%% 1.667 V centre, 0.213 V/V after the probe for voltage, 0.154 "
"V/V for current)\nK_vo = 10/0.213;  O_vo = 1.667;   % VProbe 1, 10:1: output"
" voltage, tap A - tap B\nK_il = 1/0.0154;  O_il = 1.667;   % CProbe 2, 100 m"
"V/A: leg-A inductor current\nK_io = 1/0.0154;  O_io = 1.667;   % CProbe 1, 1"
"00 mV/A: load current\nK_dc = 10/0.213;  O_dc = 1.667;   % VProbe 2, 10:1: d"
"c input voltage\nsrc  = [1 2 3 4];                 % pin carrying [vo iL io "
"vdc]: 1=B2 2=B0 3=B1 4=A6, 0=none\nH60  = 0.9949;                    % inter"
"face-board filter gain at 60 Hz (amplitude calibration)\nVdc_nom = 50;      "
"               % used if src(4) = 0\n\n%% Protection (latched; clear by sett"
"ing enableswitch to 0). Pin voltages:\nVo_trip  = 50;    % |vo| [V]   -> 0.6"
"02 V / 2.732 V\nIL_trip  = 9;     % |iL| [A]   -> 1.528 V / 1.806 V\nIo_trip"
"  = 6;     % |io| [A]   -> 1.575 V / 1.759 V\nVdc_trip = 55;    % vdc [V]   "
" -> 2.839 V\nVdc_min  = 20;    % switching starts only once the filtered vdc"
" exceeds this [V]\n\nprotection_test = 0;  % 1: lower IL_trip to 2.5 A so th"
"e load step trips the bridge\nif protection_test\n  IL_trip = 2.5;\nend\n\n%"
"% Amplitude control (see README for the loop design)\nVref_max = 32;    % la"
"rgest accepted Vref_rms [V]\nslew     = 5;     % amplitude slew [V pk per ha"
"lf cycle] = 600 V/s, also the soft start\nm_max    = 0.98;  % modulation lim"
"it; anti-windup holds the trim here\nx_max    = 10;    % integral trim limit"
" [V pk]\nI_lim    = 6;     % current limit on the half-cycle peak of the sen"
"sed iL [A]\nK_fold   = 2;     % foldback gain [V pk per A per half cycle]\nf"
"old_dec = 0.5;   % foldback recovery [V pk per half cycle]\ntau_dc   = 0.02;"
"  % dc-link voltage filter for the feedforward [s]\n\nctl_par = [N_per Ts K_"
"vo O_vo K_il O_il K_io O_io K_dc O_dc src Vdc_nom H60 Vo_trip IL_trip Io_tri"
"p Vdc_trip Vdc_min Vref_max slew m_max x_max I_lim K_fold fold_dec tau_dc];\n"
"\n%% Station (Project B sheet)\nVdc   = 50;       % ITECH setting [V]\nRs   "
" = 0.02;     % supply leads [ohm]\nCdc   = 1.1e-3;   % SEMITEACH dc link [F]"
"\nLf    = 47e-6;    % per branch, Wurth 7443783533470, +-20 %\nRLf   = 0.02;"
"     % per branch winding + wiring [ohm] (estimate)\nCf    = 62e-6;    % per"
" branch; star point floating\nRbl   = 100e3;    % capacitor bleeders [ohm]\n"
"Ron   = 0.02;     % switch on-resistance [ohm] (no IGBT/diode drop modelled)"
"\nR_bank = 250/10;  % 10 bank switches closed: 25 ohm (OP1)\nR_step = 250/10"
";  % 10 more switches: 25 || 25 = 12.5 ohm (OP2, load step)\n\n%% Interface-"
"board sensing model\nsens_par = [1500 700 900 1.667 0.213/10 0.0154 3.3 12 V"
"dc];\n\n%% Test sequence [t_en t_load_on t_ref_up t_ref_dn t_load_off V_op1 "
"V_op2]\nscen_par = [0.02 0.30 0.50 0.70 0.85 25 30];\n"
