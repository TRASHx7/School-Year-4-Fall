"_REF_UP) && t < ParamRealData(0, T_REF_DN))\n                     ? ParamRea"
"lData(0, V_OP2) : ParamRealData(0, V_OP1);\nOutputSignal(1, 0) = t >= ParamR"
"ealData(0, T_EN) ? 1.0 : 0.0;\nOutputSignal(2, 0) = (t >= ParamRealData(0, T"
"_LOAD_ON) && t < ParamRealData(0, T_LOAD_OFF))\n                     ? 1.0 :"
" 0.0;"
        Show          off
