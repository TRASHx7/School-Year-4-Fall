        Variable      "RuntimeCheck"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "HighlightLevel"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "Declarations"
        Value         "/* Interface-board sensing chain (Inverter Box Setup Guide), simulation only"
".\n * Probe -> divider -> active low-pass -> ADC pin, modelled as\n *   H(s)"
" = (1 + s/wz) / ((1 + s/wp1)(1 + s/wp2)),  fz = 1.5 kHz, fp = 700/900 Hz\n *"
" (0.5 % low and -6 deg at 60 Hz, -21 dB at 5 kHz), then\n *   V_pin = 1.667 "
"V + k*signal, 12-bit quantisation over 0..3.3 V.\n * Input  (probe order): ["
"iL, iR1, iR2, vo, vdc]\n * Output 1: pins [B2 B0 B1] = [vo iL io]   2: pin ["
"A6] = vdc\n */\n#include <math.h>\nenum { S_FZ, S_FP1, S_FP2, S_OFS, S_KV, S"
"_KI, S_VREF, S_BITS, S_VDC0, S_NUM };\nstatic double s_wz, s_wp1, s_wp2, s_q"
";\n\nstatic double s_pin(double y, double k)\n{\n    double v = ParamRealDat"
"a(0, S_OFS) + k*y;\n    v = s_q*floor(v/s_q + 0.5);\n    if (v < 0.0) v = 0."
"0;\n    if (v > ParamRealData(0, S_VREF)) v = ParamRealData(0, S_VREF);\n   "
" return v;\n}"
        Show          off
      }
      Parameter {
        Variable      "StartFcn"
        Value         "int c;\ns_wz  = 6.283185307179586*ParamRealData(0, S_FZ);\ns_wp1 = 6.2831853"
"07179586*ParamRealData(0, S_FP1);\ns_wp2 = 6.283185307179586*ParamRealData(0"
", S_FP2);\ns_q   = ParamRealData(0, S_VREF)/pow(2.0, ParamRealData(0, S_BITS"
"));\nfor (c = 0; c < 8; c++)\n    ContState(c) = 0.0;\n/* dc-link channel st"
"arts settled at the supply voltage */\nContState(6) = ParamRealData(0, S_VDC"
"0);\nContState(7) = ParamRealData(0, S_VDC0);"
        Show          off
      }
      Parameter {
        Variable      "OutputFcn"
        Value         "/* Each channel: state 2c is the first pole, state 2c+1 the output. */\nOutp"
"utSignal(0, 0) = s_pin(ContState(1), ParamRealData(0, S_KV));   /* B2: vo  *"
"/\nOutputSignal(0, 1) = s_pin(ContState(3), ParamRealData(0, S_KI));   /* B0"
": iL  */\nOutputSignal(0, 2) = s_pin(ContState(5), ParamRealData(0, S_KI)); "
"  /* B1: io  */\nOutputSignal(1, 0) = s_pin(ContState(7), ParamRealData(0, S"
"_KV));   /* A6: vdc */"
        Show          off
      }
      Parameter {
        Variable      "UpdateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "DerivativeFcn"
        Value         "double u[4];\nint c;\nu[0] = InputSignal(0, 3);                       /* vo "
"*/\nu[1] = InputSignal(0, 0);                       /* iL */\nu[2] = InputSi"
"gnal(0, 1) + InputSignal(0, 2);   /* io = iR1 + iR2 */\nu[3] = InputSignal(0"
", 4);                       /* vdc */\nfor (c = 0; c < 4; c++) {\n    double"
" d1 = s_wp1*(u[c] - ContState(2*c));\n    double w  = ContState(2*c) + d1/s_"
"wz;       /* zero */\n    ContDeriv(2*c)     = d1;\n    ContDeriv(2*c + 1) ="
" s_wp2*(w - ContState(2*c + 1));\n}"
        Show          off
      }
      Parameter {
        Variable      "TerminateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "StoreCustomStateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "RestoreCustomStateFcn"
        Value         ""
        Show          off
      }
    }
