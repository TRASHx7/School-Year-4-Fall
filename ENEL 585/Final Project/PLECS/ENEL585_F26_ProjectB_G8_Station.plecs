        Show          off
      }
      Parameter {
        Variable      "Parameters"
        Value         "ctl_par"
        Show          off
      }
      Parameter {
        Variable      "LangStandard"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "GnuExtensions"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "RuntimeCheck"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "HighlightLevel"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "Declarations"
        Value         "/* ENEL 585 Project B, Group 8: single-phase standalone inverter controller."
"\n * The same code runs in the switched station model and on the LAUNCHXL-F2"
"8P55X.\n *\n * Inputs  1: ADC unit B pins [B2 B0 B1] (V)    2: ADC unit A pi"
"n [A6] (V)\n *         3: Vref_rms (V)   4: enable (0/1)   5: Kp_amp   6: Ki"
"_amp\n * Outputs 1: [dA dB] leg duties   2: PWM enable to Powerstage Protect"
"ion\n *         3: [vo iL io] (V, A)    4: [Vpk_meas Vpk_cmd m fault Vrms IL"
"rms Pout]\n *\n * Runs once per carrier period. The 60 Hz reference is sampl"
"ed at n/N of a\n * period (n counts carrier periods), so it stays synchronou"
"s with the carrier.\n * The output amplitude is measured by synchronous demo"
"dulation over the last\n * full cycle and trimmed by an integrator; the modu"
"lation index changes only\n * at the reference zero crossings (n = 0 and n ="
" N/2).\n */\n#include <math.h>\n\n#define G8_NMAX 256                 /* sin"
"e-table capacity */\n\n/* Parameter vector ctl_par (see the model's init com"
"mands) */\nenum {\n    P_N, P_TS,                      /* samples per 60 Hz "
"period, sample time */\n    P_KVO, P_OVO, P_KIL, P_OIL,     /* pin-to-physic"
"al gain and pin offset */\n    P_KIO, P_OIO, P_KDC, P_ODC,\n    P_SRC_VO, P_"
"SRC_IL, P_SRC_IO, P_SRC_DC, /* pin index 1..4, 0 = not wired */\n    P_VDC_N"
"OM, P_H60,               /* dc voltage if unmeasured, sensor gain at 60 Hz *"
"/\n    P_VO_TRIP, P_IL_TRIP, P_IO_TRIP, P_DC_TRIP, /* protection thresholds "
"*/\n    P_DC_MIN,                       /* dc voltage needed before switchin"
"g starts */\n    P_VREF_MAX,                     /* largest accepted Vref_rm"
"s */\n    P_SLEW,                         /* amplitude slew, V pk per half c"
"ycle */\n    P_M_MAX, P_X_MAX,               /* modulation and integrator li"
"mits */\n    P_I_LIM, P_K_FOLD, P_FOLD_DEC,  /* inductor-current limit foldb"
"ack */\n    P_TAU_DC,                       /* dc voltage filter time consta"
"nt */\n    P_NUM\n};\n\n/* Latched fault bits */\n#define F_VO 1            "
"          /* output overvoltage */\n#define F_IL 2                      /* i"
"nductor overcurrent */\n#define F_IO 4                      /* output overcu"
"rrent */\n#define F_DC 8                      /* dc-link overvoltage */\n\nt"
"ypedef struct {\n    int   n;                        /* index in the 60 Hz p"
"eriod, 0..N-1 */\n    int   cnt;                      /* samples summed in t"
"his half cycle */\n    int   halves;                   /* half cycles comple"
"ted since start */\n    int   run;                      /* 1 while the bridg"
"e switches */\n    int   fault;                    /* latched fault bits */\n"
"    float sI, sQ;                   /* half-cycle sums of vo*sin, vo*cos */\n"
"    float AIh, AQh;                 /* previous half-cycle amplitudes */\n  "
"  float s_v2, s_il2, s_io2, s_p;  /* full-cycle sums for RMS and power */\n "
"   float ilpk;                     /* half-cycle peak |iL| */\n    float vc,"
" vc1;                  /* amplitude command, this and last half */\n    floa"
"t x;                        /* integral trim, V pk */\n    float fold;      "
"               /* current-limit foldback, V pk */\n    float m;             "
"           /* modulation index for this half cycle */\n    float vdcf;      "
"               /* filtered dc-link voltage */\n    float vpk;               "
"       /* measured output amplitude, V pk */\n    float vrms, ilrms, pout;  "
"      /* last full-cycle results */\n} g8_state;\n\nstatic g8_state g8, g8_n"
"ext;        /* committed state, state after this step */\nstatic float g8_si"
"n[G8_NMAX], g8_cos[G8_NMAX];\nstatic float g8_p[P_NUM];\nstatic int   g8_N, "
"g8_NH;\n\nstatic float g8_clamp(float v, float lo, float hi)\n{\n    return "
"v < lo ? lo : (v > hi ? hi : v);\n}\n\n/* Physical value of signal 'src' (pi"
"n index 1..4), or dflt if not wired. */\nstatic float g8_meas(const float *p"
"in, int k_src, int k_gain, int k_ofs, float dflt)\n{\n    int src = (int)(g8"
"_p[k_src] + 0.5f);\n    if (src < 1 || src > 4)\n        return dflt;\n    r"
"eturn g8_p[k_gain]*(pin[src - 1] - g8_p[k_ofs]);\n}"
        Show          off
      }
      Parameter {
        Variable      "StartFcn"
        Value         "/* Copy the parameters and build the sine/cosine tables once, before the PWM"
"\n * starts, so the per-step task does lookups instead of sin() calls. */\ni"
"nt k;\ng8_state zero = {0};\nfor (k = 0; k < P_NUM; k++)\n    g8_p[k] = (flo"
"at)ParamRealData(0, k);\ng8_N = (int)(g8_p[P_N] + 0.5f);\nif (g8_N > G8_NMAX"
") g8_N = G8_NMAX;\ng8_N -= g8_N % 2;                   /* even, so a half cy"
"cle is whole samples */\ng8_NH = g8_N/2;\nfor (k = 0; k < g8_N; k++) {\n    "
"g8_sin[k] = (float)sin(6.283185307179586*k/g8_N);\n    g8_cos[k] = (float)co"
"s(6.283185307179586*k/g8_N);\n}\ng8 = zero;\ng8.vdcf = g8_p[P_VDC_NOM];\ng8_"
"next = g8;"
        Show          off
      }
      Parameter {
        Variable      "OutputFcn"
        Value         "/* Work on a copy of the state; UpdateFcn commits it, so a repeated call at "
"the\n * same sample time cannot advance the controller twice. */\ng8_state s"
" = g8;\nfloat pin[4];\npin[0] = (float)InputSignal(0, 0);  /* B2: VProbe 1 *"
"/\npin[1] = (float)InputSignal(0, 1);  /* B0: CProbe 2 */\npin[2] = (float)I"
"nputSignal(0, 2);  /* B1: CProbe 1 */\npin[3] = (float)InputSignal(1, 0);  /"
"* A6: VProbe 2 */\nconst float vref_rms = (float)InputSignal(2, 0);\nconst i"
"nt   enable   = InputSignal(3, 0) > 0.5;\nconst float kp       = (float)Inpu"
"tSignal(4, 0);\nconst float ki       = (float)InputSignal(5, 0);\n\nconst fl"
"oat vo  = g8_meas(pin, P_SRC_VO, P_KVO, P_OVO, 0.0f);\nconst float il  = g8_"
"meas(pin, P_SRC_IL, P_KIL, P_OIL, 0.0f);\nconst float io  = g8_meas(pin, P_S"
"RC_IO, P_KIO, P_OIO, 0.0f);\nconst float vdc = g8_meas(pin, P_SRC_DC, P_KDC,"
" P_ODC, g8_p[P_VDC_NOM]);\n\ns.vdcf += g8_p[P_TS]/g8_p[P_TAU_DC]*(vdc - s.vd"
"cf);\n\n/* Protection, every sample. A trip latches until the enable switch "
"is set\n * to 0; while disabled the bits show any condition that is still pr"
"esent. */\nif (!enable)\n    s.fault = 0;\nif (fabsf(vo) > g8_p[P_VO_TRIP]) "
"s.fault |= F_VO;\nif (fabsf(il) > g8_p[P_IL_TRIP]) s.fault |= F_IL;\nif (g8_"
"p[P_SRC_IO] > 0.5f && fabsf(io) > g8_p[P_IO_TRIP]) s.fault |= F_IO;\nif (g8_"
"p[P_SRC_DC] > 0.5f && vdc > g8_p[P_DC_TRIP]) s.fault |= F_DC;\n\nif (!enable"
" || s.fault) {\n    s.run = 0;\n} else if (!s.run && s.vdcf >= g8_p[P_DC_MIN"
"]) {\n    /* Start at a zero crossing with zero amplitude; the slew limit ra"
"mps it. */\n    g8_state zero = {0};\n    zero.vdcf = s.vdcf;\n    s = zero;"
"\n    s.run = 1;\n}\n\n/* Half-cycle boundary: the sums now hold one complet"
"e half cycle. */\nif (s.run && (s.n == 0 || s.n == g8_NH) && s.cnt == g8_NH)"
" {\n    const float AI = 2.0f*s.sI/(float)g8_NH;\n    const float AQ = 2.0f*"
"s.sQ/(float)g8_NH;\n    /* Average with the previous half: a full-cycle wind"
"ow rejects dc offset\n     * and even harmonics as well as the odd ones. */\n"
"    const float AIf = s.halves > 0 ? 0.5f*(AI + s.AIh) : AI;\n    const floa"
"t AQf = s.halves > 0 ? 0.5f*(AQ + s.AQh) : AQ;\n    s.AIh = AI;\n    s.AQh ="
" AQ;\n    s.vpk = sqrtf(AIf*AIf + AQf*AQf)/g8_p[P_H60];\n    s.halves++;\n\n"
"    /* Compare with the command applied over the same window, so the trim\n "
"    * corrects losses rather than the measurement delay during a ramp. */\n "
"   const float r_win = s.halves > 1 ? 0.5f*(s.vc + s.vc1) : s.vc;\n    const"
" float e = r_win - s.vpk;\n    if (s.halves > 1) {\n        /* Conditional i"
"ntegration: hold the trim while the modulator is at\n         * its limit an"
"d the error would push it further. */\n        if (!(s.m >= g8_p[P_M_MAX] - "
"1e-4f && e > 0.0f))\n            s.x += ki*e;\n        s.x = g8_clamp(s.x, -"
"g8_p[P_X_MAX], g8_p[P_X_MAX]);\n    }\n\n    /* Current limit: reduce the am"
"plitude while the half-cycle peak of the\n     * sensed inductor current is "
"above I_LIM, recover slowly once below. */\n    if (s.ilpk > g8_p[P_I_LIM])\n"
"        s.fold += g8_p[P_K_FOLD]*(s.ilpk - g8_p[P_I_LIM]);\n    else\n      "
"  s.fold -= g8_p[P_FOLD_DEC];\n    s.fold = g8_clamp(s.fold, 0.0f, 1.4142135"
"6f*g8_p[P_VREF_MAX]);\n\n    /* Slew-limited amplitude command for the next "
"half cycle. */\n    float target = 1.41421356f*g8_clamp(vref_rms, 0.0f, g8_p"
"[P_VREF_MAX]) - s.fold;\n    if (target < 0.0f) target = 0.0f;\n    s.vc1 = "
"s.vc;\n    s.vc += g8_clamp(target - s.vc, -g8_p[P_SLEW], g8_p[P_SLEW]);\n\n"
"    /* Feedforward over the measured dc link plus the trim. */\n    float a "
"= s.vc + s.x + (s.halves > 1 ? kp*e : 0.0f);\n    if (a < 0.0f) a = 0.0f;\n "
"   s.m = g8_clamp(a/(s.vdcf > 1.0f ? s.vdcf : 1.0f), 0.0f, g8_p[P_M_MAX]);\n"
"\n    s.sI = 0.0f;\n    s.sQ = 0.0f;\n    s.ilpk = 0.0f;\n    s.cnt = 0;\n\n"
"    if (s.n == 0) {\n        s.vrms  = sqrtf(s.s_v2/(float)g8_N)/g8_p[P_H60]"
";\n        s.ilrms = sqrtf(s.s_il2/(float)g8_N);\n        s.pout  = s.s_p/(f"
"loat)g8_N;\n        s.s_v2 = s.s_il2 = s.s_io2 = s.s_p = 0.0f;\n    }\n}\n\n"
"float dA = 0.5f;\nif (s.run) {\n    const float sn = g8_sin[s.n];\n    dA = "
"0.5f + 0.5f*s.m*sn;\n    s.sI += vo*sn;\n    s.sQ += vo*g8_cos[s.n];\n    s."
"cnt++;\n    s.s_v2  += vo*vo;\n    s.s_il2 += il*il;\n    s.s_io2 += io*io;\n"
"    s.s_p   += vo*io;\n    if (fabsf(il) > s.ilpk) s.ilpk = fabsf(il);\n    "
"s.n = s.n + 1 >= g8_N ? 0 : s.n + 1;\n}\n\n/* Unipolar SPWM: leg B compares "
"-m*sin with the same carrier. */\nOutputSignal(0, 0) = dA;\nOutputSignal(0, "
"1) = 1.0f - dA;\nOutputSignal(1, 0) = s.run ? 1.0 : 0.0;\nOutputSignal(2, 0)"
" = vo;\nOutputSignal(2, 1) = il;\nOutputSignal(2, 2) = io;\nOutputSignal(3, "
"0) = s.vpk;\nOutputSignal(3, 1) = s.vc;\nOutputSignal(3, 2) = s.m;\nOutputSi"
"gnal(3, 3) = s.fault;\nOutputSignal(3, 4) = s.vrms;\nOutputSignal(3, 5) = s."
"ilrms;\nOutputSignal(3, 6) = s.pout;\ng8_next = s;"
        Show          off
      }
      Parameter {
        Variable      "UpdateFcn"
        Value         "g8 = g8_next;\nDiscState(0) = DiscState(0) + 1.0;   /* step counter (keeps t"
"he update call) */"
        Show          off
      }
      Parameter {
        Variable      "DerivativeFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "TerminateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "StoreCustomStateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "RestoreCustomStateFcn"
        Value         ""
        Show          off
      }
    }
