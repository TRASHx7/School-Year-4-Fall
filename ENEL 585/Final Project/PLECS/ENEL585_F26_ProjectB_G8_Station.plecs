      Parameter {
        Variable      "Declarations"
        Value         "/* Demonstration sequence for the station-sheet tests (simulation only).\n *"
" Output 1: Vref_rms   2: enable   3: load-step switch (closes 10 more bank s"
"witches)\n */\nenum { T_EN, T_LOAD_ON, T_REF_UP, T_REF_DN, T_LOAD_OFF, V_OP1"
", V_OP2 };"
        Show          off
