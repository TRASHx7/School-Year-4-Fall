    CODE model_init
        # ENEL 585 Fall 2026 - Project B HIL plant parameters.
        # Edit the load settings for your operating points, then recompile.
        # Sources: Project B sheet (Rev13), Inverter Box Setup Guide v2, vault notes.
        
        # Load bank settings [Ohm] (12.5-250 Ohm bank). SCADA 'Load A' / 'Load B' switch them in.
        R_load_A = 50.0
        R_load_B = 25.0
        
        # Filter: two branches of the LCL board (Wurth 7443783533470, 47 uH +/-20 %)
        L_f = 47e-6
        R_Lf = 11.8e-3      # inductor DC resistance, typical
        C_f = 62e-6
        R_bleed = 100e3     # bleeder across each filter capacitor
        
        # DC link (SEMITEACH): 1.1 mF, 2 x 22 kOhm balancing resistors in series
        C_dc = 1.1e-3
        R_bal = 44e3
        
        # ITECH IT-M3632 in source mode: constant-voltage with a +/-10 A current limit
        R_itech = 0.05      # assumed output resistance
        I_lim_itech = 10.0
        
        # Interface-board sense chain: V_ADC = 1.62 V + K * H(s) * V_BNC
        # Offset measured on the bench (student report, App. B Table 5); Setup Guide v2 says 1.667 V.
        V_adc_offset = 1.62
        K_vch = 0.213       # voltage channels
        K_ich = 0.154       # current channels
        f_p1 = 723.4      # Hz, FPGA measurement filter
        f_p2 = 871.9      # Hz
        f_z = 1446.9       # Hz
        tf_num = [1/(2*3.141592653589793*f_z), 1]    # (1 + s/wz)
        tf_den = [1/(2*3.141592653589793*f_p2), 1]   # (1 + s/wp2)
    ENDCODE
}
