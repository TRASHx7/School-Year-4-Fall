" Control period [s]\nKp = 1;\nKr = 20;\nf0 = 60;\nw0 = 2 * pi * f0;\nwb = 20;"
"\ndeadtime = 1e-6;\n\n%% TI CodeGen Stuff\ntarget = 'TI28P55x'\nboard_type = "
"'TI28P550SJ9LP'; % Default: TI28P550SJ9 LaunchPad\n\n% SCALING\nvoltage_senso"
"r_scale = 100;\ncurrent_sensor_scale = 0.01;\nV_adc_offset = -1.667;\nVacm.K "
"= voltage_sensor_scale / 0.213; % HIL = 470V/V\nVacm.O = V_adc_offset * volta"
"ge_sensor_scale / 0.213; % HIL = -783V\nIacm.K = 1 / (current_sensor_scale * "
"0.154); % HIL = 650A/V\nIacm.O = V_adc_offset / (current_sensor_scale * 0.154"
"); % HIL = -1083A\n\n\n% Configure I/O pins\nADC_DSP_ADCA = [6 10]; % ADCINA6"
" = AO1 = Vprobe2, ADCINA10 = AO10 = Cprobe1\nADC_DSP_ADCB = [2]; % ADCINB2 = "
"AO2 = Vprove1\nPWM_DSP_PWM = [1]; % PWM1A = DI1, PWM1B = DI2\nPWR_DSP_GPIO = "
"21;\n"
