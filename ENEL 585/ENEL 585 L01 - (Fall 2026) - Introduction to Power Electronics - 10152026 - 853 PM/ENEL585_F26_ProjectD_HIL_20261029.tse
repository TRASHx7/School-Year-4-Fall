    CODE model_init
        # ENEL 585 Fall 2026 - Project D HIL plant parameters (totem-pole PFC).
        # Edit the load settings for your operating points, then recompile.
        # Sources: Project D sheet (Rev13), Inverter Box Setup Guide v2, vault notes.
        
        # Transformer secondary, line-to-line (35-36.7 V rms, 60 Hz). The panel sets the rms value.
        V_grid_rms = 36.0
        f_grid = 60.0
        # Transformer impedance per winding: leakage about 50 uH (Philippe's recollection of the
        # Lab 3 overlap measurement, 2026-10-30; 1.8 % X on a 400 VA, 20.7 V winding) and an
        # ASSUMED 0.05 Ohm (4.7 % R). Line-to-line = two windings in series.
        R_tx = 0.1
        L_tx = 0.1e-3
        
        # Precharge: Rpc 30 Ohm / 10 W in each line (60 Ohm loop), bypassed by Bbp
        R_pc = 30.0
        
        # Hammond 195G20: 5 mH +/-15 %, 0.025 Ohm, 20 A DC
        L_boost = 5e-3
        R_L = 0.025
        
        # DC link (SEMITEACH): 1.1 mF, 2 x 22 kOhm balancing resistors in series
        C_dc = 1.1e-3
        R_bal = 44e3
        
        # Load bank settings [Ohm] (12.5-250 Ohm bank). SCADA 'Load A' / 'Load B' switch them in.
        R_load_A = 50.0
        R_load_B = 50.0
        
        # Interface-board sense chain: V_ADC = 1.62 V + K * H(s) * V_BNC
        # Offset measured on the bench (student report, App. B Table 5); Setup Guide v2 says 1.667 V.
        V_adc_offset = 1.62
        K_vch = 0.213       # voltage channels
        K_ich = 0.154       # current channels
        f_p1 = 723.4      # Hz, FPGA measurement filter
        f_p2 = 871.9      # Hz
        f_z = 1446.9       # Hz
        tf_num = [1/(2*3.141592653589793*f_z), 1]    # (1 + s/wz)
        tf_den = [1/(2*3.141592653589793*f_p2), 1]   # (1 + s/wp2)
    ENDCODE
}
