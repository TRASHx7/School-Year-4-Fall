<mxfile host="drawio" type="device"><diagram id="smart-h2-detailed" name="Detailed Block Diagram"><mxGraphModel adaptiveColors="auto" grid="1" gridSize="10" page="1" pageWidth="1560" pageHeight="760"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Smart Hydration Sensor: Detailed Block Diagram" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="700" height="40" as="geometry"/></mxCell><mxCell id="gb" value="Body Interface" style="swimlane;startSize=30;rounded=1;arcSize=2;fontSize=16;fontStyle=1;fillColor=#F7F2FA;swimlaneFillColor=#F7F2FA;strokeColor=#9673a6;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="220" height="340" as="geometry"/></mxCell><mxCell id="drv" value="&lt;b&gt;Drive electrodes ×2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;DRVP / DRVN&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="gb"><mxGeometry x="20" y="50" width="180" height="60" as="geometry"/></mxCell><mxCell id="body" value="&lt;b&gt;Body&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;upper arm tissue&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="gb"><mxGeometry x="20" y="150" width="180" height="60" as="geometry"/></mxCell><mxCell id="sns" value="&lt;b&gt;Sense electrodes ×2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;BIP / BIN&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="gb"><mxGeometry x="20" y="250" width="180" height="60" as="geometry"/></mxCell><mxCell id="b1" value="AC current" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4a5568;fontSize=12;" edge="1" parent="gb" source="drv" target="body"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b2" value="tissue voltage" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4a5568;fontSize=12;" edge="1" parent="gb" source="body" target="sns"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pcb" value="Wearable PCB" style="swimlane;startSize=30;rounded=1;arcSize=2;fontSize=16;fontStyle=1;fillColor=#F7FAF5;swimlaneFillColor=#F7FAF5;strokeColor=#82b366;html=1;" vertex="1" parent="1"><mxGeometry x="300" y="90" width="940" height="610" as="geometry"/></mxCell><mxCell id="prot" value="&lt;b&gt;Protection network&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;ESD + current limit&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="pcb"><mxGeometry x="20" y="60" width="160" height="70" as="geometry"/></mxCell><mxCell id="afe" value="&lt;b&gt;MAX30009 BioZ AFE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;I/Q receive · 256-word FIFO&lt;br&gt;lead / contact detect&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="pcb"><mxGeometry x="220" y="50" width="200" height="90" as="geometry"/></mxCell><mxCell id="lvl" value="&lt;b&gt;Level translator&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;1.8 V ↔ 3.3 V, fixed direction&lt;br&gt;only if nRF I/O is not 1.8 V&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#E8EEF7;strokeColor=#6c8ebf;" vertex="1" parent="pcb"><mxGeometry x="500" y="60" width="240" height="70" as="geometry"/></mxCell><mxCell id="temp" value="&lt;b&gt;MCP9808 ×2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;fixture + ambient · 0x18 / 0x19&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="pcb"><mxGeometry x="20" y="220" width="180" height="60" as="geometry"/></mxCell><mxCell id="imu" value="&lt;b&gt;IMU&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;3-axis accel · I²C, part TBD&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="pcb"><mxGeometry x="20" y="320" width="180" height="60" as="geometry"/></mxCell><mxCell id="bus" value="&lt;b&gt;Shared I²C bus&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;TWIM0 · 400 kHz&lt;br&gt;pull-ups on SCL / SDA&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#E8EEF7;strokeColor=#6c8ebf;" vertex="1" parent="pcb"><mxGeometry x="250" y="215" width="170" height="170" as="geometry"/></mxCell><mxCell id="nrf" value="&lt;b&gt;nRF52840&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;SPIM3: AFE only (full bandwidth)&lt;br&gt;TWIM0: I²C sensors&lt;br&gt;GPIO: AFE INT, IMU INT&lt;br&gt;BLE radio&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="pcb"><mxGeometry x="500" y="230" width="240" height="110" as="geometry"/></mxCell><mxCell id="ant" value="&lt;b&gt;2.4 GHz antenna&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;+ matching network&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="pcb"><mxGeometry x="790" y="220" width="130" height="50" as="geometry"/></mxCell><mxCell id="xtal" value="&lt;b&gt;Crystals&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;32 MHz + 32.768 kHz&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="pcb"><mxGeometry x="790" y="295" width="130" height="60" as="geometry"/></mxCell><mxCell id="swd" value="&lt;b&gt;SWD debug header&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;J-Link · bench only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="pcb"><mxGeometry x="500" y="400" width="240" height="50" as="geometry"/></mxCell><mxCell id="chg" value="&lt;b&gt;Charger&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;USB input · bench only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="pcb"><mxGeometry x="20" y="495" width="180" height="60" as="geometry"/></mxCell><mxCell id="bat" value="&lt;b&gt;Rechargeable battery&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="pcb"><mxGeometry x="250" y="490" width="170" height="70" as="geometry"/></mxCell><mxCell id="r18" value="&lt;b&gt;1.8 V regulator&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;MAX30009 AVDD / DVDD · translator A side&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="pcb"><mxGeometry x="500" y="480" width="420" height="45" as="geometry"/></mxCell><mxCell id="r33" value="&lt;b&gt;3.3 V regulator&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;nRF52840 · MCP9808 · IMU · translator B side&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="pcb"><mxGeometry x="500" y="530" width="420" height="45" as="geometry"/></mxCell><mxCell id="p1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4a5568;fontSize=12;startArrow=classic;" edge="1" parent="pcb" source="prot" target="afe"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2" value="SPI + INT&lt;br&gt;1.8 V" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4a5568;fontSize=12;startArrow=classic;" edge="1" parent="pcb" source="afe" target="lvl"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3" value="SPI + INT · 3.3 V" style="e